{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.pariwesh.in/api/v1/seo/sitemap"
    },
    {
      "source": "/google-merchant-feed.xml",
      "destination": "https://api.pariwesh.in/api/v1/seo/google-merchant-feed.xml"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
