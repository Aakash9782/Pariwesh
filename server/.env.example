# SERVER CONFIGURATION
PORT=5001
NODE_ENV=development

# DATABASE
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Priwesh

# AUTHENTICATION
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_PHONES=9782681155
ADMIN_EMAILS=admin@pariwesh.com

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EMAIL CONFIGURATION (PROVIDER FEATURE FLAG)
EMAIL_PROVIDER=brevo

# BREVO CONFIGURATION
EMAIL_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PARIWESH
EMAIL_TIMEOUT_MS=10000


# RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# TWILIO SMS (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=91
