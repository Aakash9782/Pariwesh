# SERVER CONFIGURATION
PORT=5001
NODE_ENV=development

# DATABASE
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Priwesh

# AUTHENTICATION
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_PHONES=9782681155
ADMIN_EMAILS=admin@pariwesh.com

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EMAIL — PRODUCTION (Render free blocks SMTP ports 25/465/587)
# Prefer Resend HTTPS API so OTP/order emails work on free Render:
# 1) https://resend.com → API key
# 2) Set RESEND_API_KEY on Render. Until you verify a domain, use:
#    RESEND_FROM="PARIWESH <onboarding@resend.dev>"
RESEND_API_KEY=
RESEND_FROM="PARIWESH <onboarding@resend.dev>"

# EMAIL (NODEMAILER) — local/dev or paid Render (SMTP allowed)
# https://myaccount.google.com/apppasswords
# Ignored when RESEND_API_KEY is set.
NODEMAILER_SERVICE=gmail
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_USER=
NODEMAILER_PASS=
NODEMAILER_FROM="PARIWESH" <you@example.com>
# Cap SMTP hang time (ms). Render free will always time out on SMTP.
SMTP_SEND_TIMEOUT_MS=12000

# RAZORPAY
# Get Test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# SHIPPING
# AWB is entered by admin from your courier dashboard (Delhivery / Shiprocket / etc.).
# No courier API keys required for this flow.

# CORS
FRONTEND_URL=http://localhost:5173
# On Render set: FRONTEND_URL=https://pariwesh.vercel.app
# On Render also set: NODE_ENV=production
# On Render free: set RESEND_API_KEY (Gmail SMTP will hang — ports blocked).

# TWILIO SMS (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=91
